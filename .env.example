# Kopieren nach .env und an den Server anpassen.
DOMAIN=golf.hugger.de

# Docker-Netzwerk, in dem Traefik hängt
TRAEFIK_NETWORK=web

# Namen aus der Traefik-Konfiguration (entryPoints / certificatesResolvers),
# z.B. nachsehen mit: grep -n -A2 -E "entryPoints|certificatesResolvers" /opt/docker/traefik/traefik.yml
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_CERTRESOLVER=letsencrypt

# Optional: Scorekarte per Foto auslesen (Claude-API, wenige Cent pro Foto).
# Schlüssel unter https://console.anthropic.com anlegen. Leer = Funktion ausgeblendet.
ANTHROPIC_API_KEY=
